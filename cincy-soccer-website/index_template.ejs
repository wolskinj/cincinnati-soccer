<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>

    <style>
        :root {
            --primary: #002147;
            --primary-dark: #001F3F;
            --accent: #E31837;
            --white: #FFFFFF;
            --bg: #f8fafc;
            --text-main: #002147;
            --text-light: #475569;
            --border: #e2e8f0;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            scroll-behavior: smooth;
        }

        /* HERO & SEARCH SECTION */
        .hero {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: var(--white);
            padding: 80px 20px 100px;
            text-align: center;
            border-bottom: 8px solid var(--accent);
            position: relative;
        }

        .hero-logo {
            height: 60px;
            width: auto;
            margin-bottom: 20px;
            filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.3));
        }

        .hero h1 {
            font-size: clamp(2rem, 6vw, 4rem);
            font-weight: 900;
            margin: 0;
            letter-spacing: -1px;
            text-transform: lowercase;
            text-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        }

        .hero p {
            font-size: 1.2rem;
            color: #cbd5e1;
            margin: 15px auto 40px;
            max-width: 600px;
            font-weight: 500;
        }

        /* AUTOCOMPLETE SEARCH BAR */
        .search-container {
            position: relative;
            max-width: 700px;
            margin: 0 auto;
            z-index: 50;
        }

        .search-input {
            width: 100%;
            padding: 22px 30px;
            border-radius: 50px;
            border: none;
            font-size: 1.25rem;
            font-family: inherit;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
            transition: all 0.2s;
            background: var(--white);
            color: var(--text-main);
        }

        .search-input:focus {
            outline: none;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 0 0 4px rgba(227, 24, 55, 0.3);
        }

        .search-results {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            right: 0;
            background: var(--white);
            border-radius: 16px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
            max-height: 400px;
            overflow-y: auto;
            display: none;
            text-align: left;
            border: 1px solid var(--border);
        }

        .search-results.active {
            display: block;
        }

        .search-item {
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: var(--text-main);
            border-bottom: 1px solid var(--border);
            transition: background 0.2s;
        }

        .search-item:last-child {
            border-bottom: none;
        }

        .search-item:hover {
            background: #f1f5f9;
        }

        .search-item-title {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .search-item-meta {
            font-size: 0.85rem;
            color: var(--text-light);
            background: var(--bg);
            padding: 4px 10px;
            border-radius: 20px;
            border: 1px solid var(--border);
        }

        /* HUB CARDS SECTION */
        .hub-container {
            max-width: 1200px;
            margin: -50px auto 60px;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .hub-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .hub-card {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 220px;
            border-radius: 16px;
            text-decoration: none;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .hub-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
        }

        .hub-card img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
            transition: transform 0.4s;
        }

        .hub-card:hover img {
            transform: scale(1.05);
        }

        .hub-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 33, 71, 0.7); /* Navy overlay */
            z-index: 2;
            transition: background 0.3s;
        }

        .hub-card:hover::after {
            background: rgba(0, 33, 71, 0.6);
        }

        .hub-card h2 {
            position: relative;
            z-index: 3;
            color: var(--white);
            font-size: 1.8rem;
            font-weight: 800;
            margin: 0;
            text-align: center;
            letter-spacing: -0.5px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        /* DIRECTORY SECTIONS */
        .directory-container {
            max-width: 1000px;
            margin: 0 auto 60px;
            padding: 0 20px;
        }

        .directory-section {
            background: var(--white);
            border-radius: 16px;
            padding: 40px;
            margin-bottom: 40px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .directory-section h3 {
            font-size: 1.8rem;
            color: var(--primary);
            margin-top: 0;
            margin-bottom: 25px;
            border-bottom: 2px solid var(--border);
            padding-bottom: 10px;
        }

        .link-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
        }

        a.dir-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 15px;
            background: var(--bg);
            color: var(--primary);
            text-decoration: none;
            border-radius: 8px;
            font-weight: 700;
            border: 1px solid var(--border);
            transition: all 0.2s;
            text-align: center;
            min-height: 70px;
        }

        a.dir-link:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: var(--white);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        /* FOOTER */
        footer {
            text-align: center;
            margin-top: 80px;
            padding: 60px 20px;
            background: var(--primary);
            color: #cbd5e1;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>

    <header class="hero">
        <img src="assets/logo.webp" alt="Cincinnati Soccer Logo" class="hero-logo" width="250" height="250" fetchpriority="high">
        <h1>cincinnati.soccer</h1>
        <p>The smartest way to find Cincinnati youth soccer schedules.</p>
        
        <div class="search-container">
            <input type="search" id="global-search" class="search-input" placeholder="Search for a team, club, or division..." autocomplete="off">
            <div id="search-results" class="search-results">
                <!-- Javascript will inject results here -->
            </div>
        </div>

        <section class="ai-summary-box" style="max-width: 750px; margin: 35px auto 0; padding: 18px 24px; background: rgba(255,255,255,0.08); border-radius: 12px; border-left: 4px solid var(--accent); text-align: left;">
            <h2 style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: #94a3b8; margin: 0 0 6px 0; font-weight: 700;">Directory Overview &amp; Quick Facts</h2>
            <p style="font-size: 0.95rem; color: #e2e8f0; margin: 0; line-height: 1.5;">
                <strong>cincinnati.soccer</strong> is the centralized schedule directory tracking <strong>1,380+ active youth soccer teams</strong> and <strong>270+ age divisions</strong> across Greater Cincinnati and Southwestern Ohio for the Fall 2025 &amp; Spring 2026 season. Aggregating schedules across Cardinal Premier (CPL), Buckeye Premier (BPYSL), Ohio Soccer State League (OSSL), and Club v Club (CvC).
            </p>
        </section>
    </header>

    <main>
        <!-- THE HUB CARDS -->
        <div class="hub-container">
            <div class="hub-grid">
                <a href="clubs.html" class="hub-card">
                    <img src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?q=80&w=800&auto=format&fit=crop" alt="Soccer Ball" loading="lazy">
                    <h2>Browse by Club</h2>
                </a>
                <a href="ages.html" class="hub-card">
                    <img src="https://images.unsplash.com/photo-1526232761682-d26e03ac148e?q=80&w=800&auto=format&fit=crop" alt="Kids playing soccer" loading="lazy">
                    <h2>Browse by Age</h2>
                </a>
                <a href="leagues.html" class="hub-card">
                    <img src="https://images.unsplash.com/photo-1604651684573-05470013b3b9?q=80&w=800&auto=format&fit=crop" alt="Youth soccer players" loading="lazy">
                    <h2>Browse by League</h2>
                </a>
            </div>
        </div>


    </main>

    <footer>
        <p>Updated for the current season. Not affiliated with CPL, BPYSL, or individual clubs.<br>
            Built by parents and players for parents and players. <strong>Last verified: <%- lastUpdated %></strong></p>
    </footer>

    <!-- SEARCH AUTOCOMPLETE LOGIC -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('global-search');
            const searchResults = document.getElementById('search-results');
            let searchIndex = null;

            // Fetch the static JSON index
            fetch('/search-index.json')
                .then(response => response.json())
                .then(data => {
                    searchIndex = data;
                })
                .catch(err => console.error("Failed to load search index:", err));

            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase().trim();
                
                if (!query || query.length < 2 || !searchIndex) {
                    searchResults.classList.remove('active');
                    return;
                }

                // Filter logic
                const matches = searchIndex.filter(item => {
                    return item.name.toLowerCase().includes(query) || 
                           (item.club && item.club.toLowerCase().includes(query));
                }).slice(0, 10); // Limit to top 10

                // Render results
                if (matches.length > 0) {
                    searchResults.innerHTML = matches.map(item => `
                        <a href="${item.url}" class="search-item">
                            <span class="search-item-title">${item.name}</span>
                            <span class="search-item-meta">${item.type.toUpperCase()}</span>
                        </a>
                    `).join('');
                    searchResults.classList.add('active');
                } else {
                    searchResults.innerHTML = `<div class="search-item"><span class="search-item-title" style="color: #64748b; font-weight: normal;">No teams found for "${query}"</span></div>`;
                    searchResults.classList.add('active');
                }
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', (e) => {
                if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                    searchResults.classList.remove('active');
                }
            });
        });
    </script>
</body>
</html>
