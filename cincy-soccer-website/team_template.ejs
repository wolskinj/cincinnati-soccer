<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- title %> | cincinnati.soccer</title>

    <meta name="theme-color" content="#002147">
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin>

    <meta name="description" content="<%- description %>">

    <!-- Open Graph / Social -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%- canonicalUrl %>">
    <meta property="og:title" content="<%- title %> | cincinnati.soccer">
    <meta property="og:description" content="<%- description %>">
    <meta property="og:image" content="<%- domain %>/assets/logo.webp">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    [
      {
        "@context": "https://schema.org",
        "@type": "SportsTeam",
        "name": "<%- teamName %>",
        "sport": "Soccer",
        <% 
          let members = [];
          if (teamRows.length > 0 && teamRows[0].CLUB && teamRows[0].CLUB !== 'Independent') {
            members.push(`{"@type": "SportsOrganization", "name": "${teamRows[0].CLUB}"}`);
          }
          if (teamRows.length > 0 && teamRows[0].LEAGUE) {
            members.push(`{"@type": "SportsOrganization", "name": "${teamRows[0].LEAGUE}"}`);
          }
        %>
        "memberOf": [
          <%- members.join(',') %>
        ],
        "location": {
          "@type": "Place",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cincinnati",
            "addressRegion": "OH"
          }
        },
        "url": "<%- canonicalUrl %>",
        "description": "<%- description.replace(/"/g, '\\"') %>"
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "<%- domain %>/"
          },
          <% if (teamRows.length > 0 && teamRows[0].CLUB && teamRows[0].CLUB !== 'Independent') { %>
          {
            "@type": "ListItem",
            "position": 2,
            "name": "<%- teamRows[0].CLUB %>",
            "item": "<%- domain %>/club-<%- makeFilename(teamRows[0].CLUB) %>"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "<%- teamName %>",
            "item": "<%- canonicalUrl %>"
          }
          <% } else if (teamRows.length > 0 && teamRows[0].DIVISION) { 
             const divInfo = normalizeDivision(teamRows[0].DIVISION);
             const ageUrl = `${domain}/${divInfo.gender.toLowerCase()}-${divInfo.age.toLowerCase().replace(/[^a-z0-9]/g, '-')}.html`;
          %>
          {
            "@type": "ListItem",
            "position": 2,
            "name": "<%- teamRows[0].DIVISION %>",
            "item": "<%- ageUrl %>"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "<%- teamName %>",
            "item": "<%- canonicalUrl %>"
          }
          <% } else { %>
          {
            "@type": "ListItem",
            "position": 2,
            "name": "<%- teamName %>",
            "item": "<%- canonicalUrl %>"
          }
          <% } %>
        ]
      }
    ]
    </script>

    <style>
        :root {
            --primary: #002147;
            --primary-dark: #001F3F;
            --accent: #E31837;
            --accent-hover: #C41230;
            --white: #FFFFFF;

            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #002147;
            --text-light: #475569;
            --border: #e2e8f0;

            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            --shadow-hover: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
            background-color: var(--bg);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            line-height: 1.5;
        }

        .container {
            max-width: 900px;
            margin: 20px auto;
            padding: 0 15px;
        }

        /* COMPACT HERO & SEARCH SECTION */
        .compact-hero {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: var(--white);
            padding: 20px 20px 40px;
            border-bottom: 4px solid var(--accent);
            position: relative;
            margin-bottom: 30px;
        }

        .compact-hero-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1000px;
            margin: 0 auto 30px;
            gap: 20px;
            flex-wrap: wrap;
        }

        .compact-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--white);
            font-weight: 800;
            font-size: 1.2rem;
            letter-spacing: -0.5px;
        }

        .compact-logo img {
            height: 40px;
            width: auto;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
        }

        .compact-search-container {
            position: relative;
            flex-grow: 1;
            max-width: 500px;
            z-index: 50;
        }

        .compact-search-input {
            width: 100%;
            padding: 12px 20px;
            border-radius: 50px;
            border: none;
            font-size: 1rem;
            font-family: inherit;
            background: rgba(255, 255, 255, 0.1);
            color: var(--white);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.2s;
        }

        .compact-search-input::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .compact-search-input:focus {
            outline: none;
            background: var(--white);
            color: var(--text-main);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2), 0 0 0 3px rgba(227, 24, 55, 0.3);
        }

        .compact-hero-bottom {
            max-width: 1000px;
            margin: 0 auto;
            text-align: center;
        }

        .compact-hero-bottom h1 {
            font-size: 2.2rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.5px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
            color: var(--white);
        }

        .compact-hero-bottom .tags-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin-top: 15px;
        }

        .tag {
            background: rgba(255, 255, 255, 0.1);
            color: var(--white);
            padding: 5px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* SEARCH RESULTS BOX */
        .search-results {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            right: 0;
            background: var(--white);
            border-radius: 16px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
            max-height: 400px;
            overflow-y: auto;
            display: none;
            text-align: left;
            border: 1px solid var(--border);
        }

        .search-results.active {
            display: block;
        }

        .search-item {
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: var(--text-main);
            border-bottom: 1px solid var(--border);
            transition: background 0.2s;
        }

        .search-item:last-child {
            border-bottom: none;
        }

        .search-item:hover {
            background: #f1f5f9;
        }

        .search-item-title {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .search-item-meta {
            font-size: 0.85rem;
            color: var(--text-light);
            background: var(--bg);
            padding: 4px 10px;
            border-radius: 20px;
            border: 1px solid var(--border);
        }

        .league-participation {
            display: flex;
            flex-direction: column;
            gap: 40px;
            max-width: 800px;
            margin: 0 auto;
        }

        .participation-card {
            background: var(--card-bg);
            border: none;
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); /* Tonal lift */
            transition: all 0.2s ease;
            position: relative;
            overflow: hidden;
            text-align: left;
        }

        .participation-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        }

        .participation-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: var(--primary);
        }

        .participation-league {
            font-size: 2.2rem;
            font-weight: 900;
            color: var(--primary);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: -0.02em;
        }

        .participation-league a {
            color: inherit;
            text-decoration: none;
        }

        .participation-league a:hover {
            text-decoration: underline;
        }

        .participation-division {
            font-size: 1.15rem;
            color: var(--text-light);
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .participation-division a {
            color: var(--accent);
            text-decoration: none;
        }

        .participation-division a:hover {
            text-decoration: underline;
        }

        .btn {
            display: block;
            width: 100%;
            text-align: center;
            padding: 20px 24px;
            background: var(--accent);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-size: 1.15rem;
            font-weight: 800;
            transition: background 0.2s, transform 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn:hover {
            background: var(--primary);
            transform: translateY(-2px);
        }

        footer {
            text-align: center;
            margin-top: 80px;
            padding: 60px 20px;
            background: var(--primary);
            color: #cbd5e1;
            font-size: 0.9rem;
        }

        .breadcrumb {
            margin-bottom: 20px;
            font-size: 0.9rem;
            color: var(--text-light);
        }
        .breadcrumb ol {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-wrap: wrap;
        }
        .breadcrumb li {
            display: flex;
            align-items: center;
        }
        .breadcrumb li:not(:last-child)::after {
            content: "›";
            margin: 0 8px;
            color: #94a3b8;
        }
        .breadcrumb a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
        }
        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .intro-text {
            max-width: 800px;
            margin: 0 auto 40px auto;
            color: var(--text-light);
            font-size: 1.1rem;
            line-height: 1.6;
        }

        .section-title {
            text-align: center;
            color: var(--primary);
            font-size: 1.5rem;
            margin-bottom: 20px;
        }
    </style>

    <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png">

    <link rel="canonical" href="<%- canonicalUrl %>" />
    <meta property="og:site_name" content="cincinnati.soccer">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%- title %> | cincinnati.soccer">
    <meta name="twitter:description" content="<%- description %>">
</head>

<body>

    <header class="compact-hero">
        <div class="compact-hero-top">
            <a href="index.html" class="compact-logo">
                <img src="assets/logo.webp" alt="Cincinnati Soccer Logo" width="40" height="40" fetchpriority="high">
                <span>cincinnati.soccer</span>
            </a>
            <div class="compact-search-container">
                <input type="search" id="global-search" class="compact-search-input" placeholder="Search for a team, club, or division..." autocomplete="off">
                <div id="search-results" class="search-results"></div>
            </div>
        </div>
        <div class="compact-hero-bottom">
            <h1><%- teamName %></h1>
            <div class="tags-row">
                <% if (teamRows.length > 0 && teamRows[0].DIVISION) { 
                    const divInfo = normalizeDivision(teamRows[0].DIVISION);
                    const ageUrl = `${divInfo.gender.toLowerCase()}-${divInfo.age.toLowerCase().replace(/[^a-z0-9]/g, '-')}.html`;
                %>
                    <a href="<%- ageUrl %>" class="tag division-tag"><span aria-hidden="true">📅</span> <%- divInfo.label %></a>
                <% } %>
                
                <% if (teamRows.length > 0 && teamRows[0].CLUB && teamRows[0].CLUB !== 'Independent') { %>
                    <a href="club-<%- makeFilename(teamRows[0].CLUB) %>" class="tag club-tag"><span aria-hidden="true">⚽</span> <%- teamRows[0].CLUB %></a>
                <% } else if (teamRows.length > 0 && teamRows[0].CLUB) { %>
                    <span class="tag"><span aria-hidden="true">⚽</span> <%- teamRows[0].CLUB %></span>
                <% } %>
                
                <% if (teamRows.length > 0 && teamRows[0].LEAGUE) { 
                    const leagueUrl = `league-${makeFilename(teamRows[0].LEAGUE)}`;
                %>
                    <a href="<%- leagueUrl %>" class="tag league-tag"><span aria-hidden="true">🏆</span> <%- teamRows[0].LEAGUE %></a>
                <% } %>
            </div>
        </div>
    </header>

    <div class="container">

        <main>
            <nav aria-label="breadcrumb" class="breadcrumb">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <% if (teamRows.length > 0 && teamRows[0].CLUB && teamRows[0].CLUB !== 'Independent') { %>
                    <li><a href="club-<%- makeFilename(teamRows[0].CLUB) %>"><%- teamRows[0].CLUB %></a></li>
                    <% } else if (teamRows.length > 0 && teamRows[0].DIVISION) { 
                        const divInfo = normalizeDivision(teamRows[0].DIVISION);
                        const ageUrl = `${divInfo.gender.toLowerCase()}-${divInfo.age.toLowerCase().replace(/[^a-z0-9]/g, '-')}.html`;
                    %>
                    <li><a href="<%- ageUrl %>"><%- teamRows[0].DIVISION %></a></li>
                    <% } %>
                    <li aria-current="page"><%- teamName %></li>
                </ol>
            </nav>

            <p class="intro-text">
                <strong><%- teamName %></strong> is a competitive youth soccer team based in Cincinnati, OH<% if (teamRows.length > 0 && teamRows[0].CLUB && teamRows[0].CLUB !== 'Independent') { %>, affiliated with <%- teamRows[0].CLUB %><% } %>. For the current season, they are competing <% if (teamRows.length > 0 && teamRows[0].DIVISION) { %>in the <%- teamRows[0].DIVISION %> bracket<% } %><% if (teamRows.length > 0 && teamRows[0].LEAGUE) { %> within the <%- teamRows[0].LEAGUE %><% } %>.
            </p>

            <h2 class="section-title">League Participation</h2>
            <div class="league-participation">
                <% teamRows.forEach(function(row) { 
                    const divInfo = normalizeDivision(row.DIVISION);
                    const ageUrl = `${divInfo.gender.toLowerCase()}-${divInfo.age.toLowerCase().replace(/[^a-z0-9]/g, '-')}.html`;
                    const leagueUrl = `league-${makeFilename(row.LEAGUE)}`;
                    
                    const leagueConfig = leaguesConfig.find(l => l.id === row.LEAGUE);
                    const fullLeagueName = leagueConfig ? leagueConfig.name : row.LEAGUE;
                %>
                <div class="participation-card">
                    <div class="participation-league">
                        <span aria-hidden="true">🏆</span> <a href="<%- leagueUrl %>"><%- fullLeagueName %></a>
                    </div>
                    <div class="participation-division">
                        <span aria-hidden="true">📅</span> <a href="<%- ageUrl %>"><%- row.DIVISION %></a>
                    </div>
                    <div style="margin-top: 25px;">
                        <a href="<%- row.SCHEDULE_LINK %>" class="btn" target="_blank">View Schedule & Standings ➜</a>
                    </div>
                </div>
                <% }); %>
            </div>

        </main>

    </div>

    <footer>
        <p>Updated for the current season. Not affiliated with CPL, BPYSL, or individual clubs.<br>
            Built by parents and players for parents and players. <strong>Last verified: <%- lastUpdated %></strong></p>
        <p style="margin-top: 15px; font-size: 0.8rem;"><a href="/privacy-policy.html"
                style="color: inherit; text-decoration: underline;">Privacy Policy</a> | <a href="/cookie-policy.html"
                style="color: inherit; text-decoration: underline;">Cookie Policy</a></p>
        <p style="margin-top: 10px; font-size: 0.8rem;"><a href="https://cincinnati.soccer"
                style="color: inherit; text-decoration: underline;">cincinnati.soccer</a> © 2026 by <a
                href="https://cincinnati.soccer"
                style="color: inherit; text-decoration: underline;">cincinnati.soccer</a> is
            licensed under <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/"
                style="color: inherit; text-decoration: underline;">CC BY-NC-ND 4.0</a></p>
    </footer>

    <script>
        // Global Search Logic
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('global-search');
            const searchResults = document.getElementById('search-results');
            let searchIndex = null;

            if (searchInput) {
                fetch('/search-index.json')
                    .then(response => response.json())
                    .then(data => {
                        searchIndex = data;
                    })
                    .catch(err => console.error("Failed to load search index:", err));

                searchInput.addEventListener('input', (e) => {
                    const query = e.target.value.toLowerCase().trim();
                    
                    if (!query || query.length < 2 || !searchIndex) {
                        searchResults.classList.remove('active');
                        return;
                    }

                    const matches = searchIndex.filter(item => {
                        return item.name.toLowerCase().includes(query) || 
                               (item.club && item.club.toLowerCase().includes(query));
                    }).slice(0, 10);

                    if (matches.length > 0) {
                        searchResults.innerHTML = matches.map(item => `
                            <a href="${item.url}" class="search-item">
                                <span class="search-item-title">${item.name}</span>
                                <span class="search-item-meta">${item.type.toUpperCase()}</span>
                            </a>
                        `).join('');
                        searchResults.classList.add('active');
                    } else {
                        searchResults.innerHTML = `<div class="search-item"><span class="search-item-title" style="color: #64748b; font-weight: normal;">No teams found for "${query}"</span></div>`;
                        searchResults.classList.add('active');
                    }
                });

                document.addEventListener('click', (e) => {
                    if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                        searchResults.classList.remove('active');
                    }
                });
            }
        });
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7915021068737339" crossorigin="anonymous"></script>
</body>
</html>
