<!-- SEARCH AUTOCOMPLETE LOGIC -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('global-search');
        const searchResults = document.getElementById('search-results');
        if (!searchInput || !searchResults) return;

        let searchIndex = null;

        function isSafeUrl(url) {
            return typeof url === 'string' && (url.startsWith('/') || /^https?:\/\//i.test(url));
        }

        function renderSearchResults(matches, query) {
            const fragment = document.createDocumentFragment();

            if (matches.length > 0) {
                matches.forEach((item) => {
                    const link = document.createElement('a');
                    link.className = 'search-item';
                    link.setAttribute('href', isSafeUrl(item.url) ? item.url : '#');

                    const title = document.createElement('span');
                    title.className = 'search-item-title';
                    title.textContent = item.name || '';

                    const meta = document.createElement('span');
                    meta.className = 'search-item-meta';
                    meta.textContent = (item.type || '').toUpperCase();

                    link.append(title, meta);
                    fragment.append(link);
                });
            } else {
                const emptyRow = document.createElement('div');
                emptyRow.className = 'search-item';

                const msg = document.createElement('span');
                msg.className = 'search-item-title';
                msg.style.color = '#64748b';
                msg.style.fontWeight = 'normal';
                msg.textContent = `No results found for "${query}"`;

                emptyRow.append(msg);
                fragment.append(emptyRow);
            }

            searchResults.replaceChildren(fragment);
            searchResults.classList.add('active');
        }

        // Fetch the static JSON index
        fetch('/search-index.json')
            .then(response => response.json())
            .then(data => {
                searchIndex = data;
            })
            .catch(err => console.error('Failed to load search index:', err));

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();

            if (!query || query.length < 2 || !searchIndex) {
                searchResults.classList.remove('active');
                return;
            }

            const matches = searchIndex.filter(item => {
                return (item.name && item.name.toLowerCase().includes(query)) ||
                       (item.club && item.club.toLowerCase().includes(query));
            }).slice(0, 10);

            renderSearchResults(matches, query);
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                searchResults.classList.remove('active');
            }
        });
    });
</script>
