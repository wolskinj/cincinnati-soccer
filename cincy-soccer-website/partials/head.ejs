<% 
let rawTitle = typeof title !== 'undefined' && title ? title : 'cincinnati.soccer';
let metaTitle = rawTitle;
const BRAND = ' | cincinnati.soccer';
const MAX_TITLE_LEN = 59;

if (!metaTitle.includes('cincinnati.soccer')) {
    const avail = MAX_TITLE_LEN - BRAND.length;
    if (metaTitle.length > avail) {
        let truncated = metaTitle.substring(0, avail - 3);
        const lastSpace = truncated.lastIndexOf(' ');
        if (lastSpace > 12) {
            truncated = truncated.substring(0, lastSpace);
        }
        metaTitle = truncated.trim() + '...';
    }
    metaTitle = metaTitle + BRAND;
}

let metaDesc = typeof description !== 'undefined' ? description : '';
if (typeof clubAbout !== 'undefined' && clubAbout) metaDesc = clubAbout;
if (typeof divisionAbout !== 'undefined' && divisionAbout) metaDesc = divisionAbout;
if (typeof leagueAbout !== 'undefined' && leagueAbout) metaDesc = leagueAbout;
metaDesc = metaDesc.replace(/<[^>]*>?/gm, '').trim();
if (!metaDesc) {
    metaDesc = "The centralized directory for Cincinnati youth soccer schedules, standings, and team rankings. Track CPL, BPYSL, and club teams in one place.";
}

let currentUrl = typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : (domain + '/');
let defaultOgImage = domain + '/assets/social-share-og.jpg';
let shareImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : defaultOgImage;
let shareImageAlt = typeof ogImageAlt !== 'undefined' && ogImageAlt ? ogImageAlt : (metaTitle + " - Cincinnati Youth Soccer");
let modDate = typeof isoDate !== 'undefined' && isoDate ? isoDate : new Date().toISOString();
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%- metaTitle %></title>

<meta name="description" content="<%- metaDesc %>">
<link rel="canonical" href="<%- currentUrl %>">
<meta name="theme-color" content="#002147">

<!-- Data Freshness & AI Search Signals -->
<meta property="article:modified_time" content="<%- modDate %>">
<meta property="og:updated_time" content="<%- modDate %>">

<!-- Favicons & Web App Manifest -->
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon.png">
<link rel="shortcut icon" href="/assets/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/assets/site.webmanifest">

<!-- Machine-Readable Data Discovery -->
<link rel="alternate" type="application/json" title="Cincinnati Soccer Directory Search Index" href="/search-index.json">

<!-- Open Graph / Social Media Meta Tags -->
<meta property="og:site_name" content="cincinnati.soccer">
<meta property="og:locale" content="en_US">
<meta property="og:type" content="website">
<meta property="og:url" content="<%- currentUrl %>">
<meta property="og:title" content="<%- metaTitle %>">
<meta property="og:description" content="<%- metaDesc %>">
<meta property="og:image" content="<%- shareImage %>">
<meta property="og:image:secure_url" content="<%- shareImage %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%- shareImageAlt %>">

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%- metaTitle %>">
<meta name="twitter:description" content="<%- metaDesc %>">
<meta name="twitter:image" content="<%- shareImage %>">
<meta name="twitter:image:alt" content="<%- shareImageAlt %>">

<!-- Google AdSense & Speed Connection Hints -->
<link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin>
<link rel="dns-prefetch" href="https://googleads.g.doubleclick.net">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7915021068737339" crossorigin="anonymous"></script>

<!-- JSON-LD Structured Data -->
<% if (typeof type !== 'undefined' && type === 'team') { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsTeam",
  "name": "<%- typeof teamName !== 'undefined' ? teamName : title %>",
  "sport": "Soccer",
  "url": "<%- currentUrl %>",
  "description": "<%- metaDesc %>",
  "dateModified": "<%- modDate %>",
  "location": {
    "@type": "Place",
    "name": "Cincinnati, OH"
  }
}
</script>
<% } else if (typeof type !== 'undefined' && type === 'club') { %>
<script type="application/ld+json">
[
  {
    "@context": "https://schema.org",
    "@type": "SportsOrganization",
    "name": "<%- title %>",
    "sport": "Soccer",
    "areaServed": "Cincinnati",
    "url": "<%- currentUrl %>",
    "description": "<%- metaDesc %>",
    "dateModified": "<%- modDate %>"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "<%- domain %>/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "<%- title %>",
        "item": "<%- currentUrl %>"
      }
    ]
  }
]
</script>
<% } else { %>
<script type="application/ld+json">
[
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "<%- title %>",
    "url": "<%- currentUrl %>",
    "description": "<%- metaDesc %>",
    "dateModified": "<%- modDate %>"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What youth soccer leagues operate in Greater Cincinnati?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "cincinnati.soccer indexes schedules, standings, and team rosters for Cardinal Premier League (CPL), Buckeye Premier Youth Soccer League (BPYSL), Ohio Soccer State League (OSSL), and Club v Club (CvC)."
        }
      },
      {
        "@type": "Question",
        "name": "Where can I find schedules and standings for Cincinnati youth soccer teams?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "cincinnati.soccer is the centralized directory for youth soccer schedules, standings, and team rankings across Southwestern Ohio, indexing over 1,380 active teams."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "<%- domain %>/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "<%- title %>",
        "item": "<%- currentUrl %>"
      }
    ]
  }
]
</script>
<% } %>
