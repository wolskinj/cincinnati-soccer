<% 
let rawTitle = typeof title !== 'undefined' && title ? title : 'cincinnati.soccer';
let metaTitle = rawTitle;
const BRAND = ' | cincinnati.soccer';
const MAX_TITLE_LEN = 59;

if (!metaTitle.includes('cincinnati.soccer')) {
    const avail = MAX_TITLE_LEN - BRAND.length;
    if (metaTitle.length > avail) {
        let truncated = metaTitle.substring(0, avail - 3);
        const lastSpace = truncated.lastIndexOf(' ');
        if (lastSpace > 12) {
            truncated = truncated.substring(0, lastSpace);
        }
        metaTitle = truncated.trim() + '...';
    }
    metaTitle = metaTitle + BRAND;
}

let metaDesc = typeof description !== 'undefined' ? description : '';
if (typeof clubAbout !== 'undefined' && clubAbout) metaDesc = clubAbout;
if (typeof divisionAbout !== 'undefined' && divisionAbout) metaDesc = divisionAbout;
if (typeof leagueAbout !== 'undefined' && leagueAbout) metaDesc = leagueAbout;
metaDesc = metaDesc.replace(/<[^>]*>?/gm, '').trim();
if (!metaDesc) {
    metaDesc = "The centralized directory for Cincinnati youth soccer schedules, standings, and team rankings. Track CPL, BPYSL, and club teams in one place.";
}

let currentUrl = typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : (domain + '/');
let defaultOgImage = (typeof type !== 'undefined' && (type === 'tournament' || type === 'tournaments')) 
    ? (domain + '/assets/hub-tournaments.jpg') 
    : (domain + '/assets/social-share-og.jpg');
let shareImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : defaultOgImage;
let shareImageAlt = typeof ogImageAlt !== 'undefined' && ogImageAlt ? ogImageAlt : (metaTitle + " - Cincinnati Youth Soccer");
let modDate = typeof isoDate !== 'undefined' && isoDate ? isoDate : new Date().toISOString();
let activeSeason = typeof currentSeason !== 'undefined' && currentSeason ? currentSeason : 'Fall 2026';
%>
<!-- 1. Critical Character Encoding & Viewport -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- 2. Primary Title & SEO Metadata -->
<title><%- metaTitle %></title>
<meta name="description" content="<%- metaDesc %>">
<link rel="canonical" href="<%- currentUrl %>">
<meta name="theme-color" content="#002147">

<!-- 3. Early Network Resource Hints & Asynchronous External Scripts -->
<link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin>
<link rel="dns-prefetch" href="https://googleads.g.doubleclick.net">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7915021068737339" crossorigin="anonymous"></script>

<!-- 4. Favicons & Web App Manifest -->
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon.png">
<link rel="shortcut icon" href="/assets/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/assets/site.webmanifest">

<!-- 5. Resource Discovery Feeds & Data Freshness Signals -->
<link rel="alternate" type="application/json" title="Cincinnati Soccer Directory Search Index" href="/search-index.json">
<meta property="article:modified_time" content="<%- modDate %>">
<meta property="og:updated_time" content="<%- modDate %>">

<!-- 6. Open Graph Social Media Meta Tags -->
<meta property="og:site_name" content="cincinnati.soccer">
<meta property="og:locale" content="en_US">
<meta property="og:type" content="website">
<meta property="og:url" content="<%- currentUrl %>">
<meta property="og:title" content="<%- metaTitle %>">
<meta property="og:description" content="<%- metaDesc %>">
<meta property="og:image" content="<%- shareImage %>">
<meta property="og:image:secure_url" content="<%- shareImage %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%- shareImageAlt %>">

<!-- 7. Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%- metaTitle %>">
<meta name="twitter:description" content="<%- metaDesc %>">
<meta name="twitter:image" content="<%- shareImage %>">
<meta name="twitter:image:alt" content="<%- shareImageAlt %>">

<!-- 8. JSON-LD Structured Data (Schema.org) -->
<%
let schemaBlocks = [];

// A. Primary Entity Schema
if (typeof type !== 'undefined' && type === 'team') {
  schemaBlocks.push({
    "@context": "https://schema.org",
    "@type": "SportsTeam",
    "name": typeof teamName !== 'undefined' ? teamName : title,
    "sport": "Soccer",
    "url": currentUrl,
    "description": metaDesc,
    "dateModified": modDate,
    "location": {
      "@type": "Place",
      "name": "Cincinnati, OH"
    }
  });
} else if (typeof type !== 'undefined' && type === 'club') {
  schemaBlocks.push({
    "@context": "https://schema.org",
    "@type": "SportsOrganization",
    "name": title,
    "sport": "Soccer",
    "areaServed": "Cincinnati",
    "url": currentUrl,
    "description": metaDesc,
    "dateModified": modDate
  });
} else if (typeof type !== 'undefined' && type === 'tournament') {
  let tObj = typeof tournament !== 'undefined' ? tournament : {};
  let locationEntities = [];
  if (tObj.venues && Array.isArray(tObj.venues) && tObj.venues.length > 0) {
    locationEntities = tObj.venues.map(v => ({
      "@type": "Place",
      "name": v.name,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": v.city || "Cincinnati, OH",
        "addressRegion": "OH",
        "addressCountry": "US"
      }
    }));
  } else {
    locationEntities.push({
      "@type": "Place",
      "name": "Greater Cincinnati, OH",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Cincinnati",
        "addressRegion": "OH",
        "addressCountry": "US"
      }
    });
  }

  let sportsEventSchema = {
    "@context": "https://schema.org",
    "@type": "SportsEvent",
    "name": tObj.name || title,
    "sport": "Soccer",
    "url": currentUrl,
    "description": metaDesc,
    "dateModified": modDate,
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": locationEntities.length === 1 ? locationEntities[0] : locationEntities
  };

  if (tObj.startDate) sportsEventSchema.startDate = tObj.startDate;
  if (tObj.endDate) sportsEventSchema.endDate = tObj.endDate;
  if (tObj.hostClub) {
    sportsEventSchema.organizer = {
      "@type": "SportsOrganization",
      "name": tObj.hostClub,
      "url": tObj.website || currentUrl
    };
  }
  if (tObj.url || tObj.website) {
    sportsEventSchema.offers = {
      "@type": "Offer",
      "url": tObj.url || tObj.website || currentUrl,
      "price": "0",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "validFrom": modDate,
      "description": "Spectator admission & public division match schedules"
    };
  }
  schemaBlocks.push(sportsEventSchema);
} else if (typeof type !== 'undefined' && type === 'tournaments') {
  let listElements = [];
  if (typeof tournamentsData !== 'undefined' && Array.isArray(tournamentsData)) {
    listElements = tournamentsData.map((t, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": t.name,
      "url": `${domain}/tournament-${t.id}.html`
    }));
  }
  let collSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "url": currentUrl,
    "description": metaDesc,
    "dateModified": modDate
  };
  if (listElements.length > 0) {
    collSchema.mainEntity = {
      "@type": "ItemList",
      "itemListElement": listElements
    };
  }
  schemaBlocks.push(collSchema);
} else {
  schemaBlocks.push({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "url": currentUrl,
    "description": metaDesc,
    "dateModified": modDate
  });
}

// B. Dynamic FAQPage Schema
let faqEntities = [];

if (typeof type !== 'undefined' && type === 'team') {
    const rawName = typeof teamName !== 'undefined' ? teamName : title;
    const firstR = typeof teamRows !== 'undefined' && teamRows && teamRows[0] ? teamRows[0] : {};
    const teamClub = firstR.CLUB && firstR.CLUB !== 'Independent' ? firstR.CLUB : null;
    const teamDiv = firstR.DIVISION || '';
    const teamLeague = firstR.LEAGUE || '';

    faqEntities.push({
        "@type": "Question",
        "name": `What league and division does ${rawName} play in for ${activeSeason}?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${rawName} competes in the ${teamLeague || 'local youth soccer league'}${teamDiv ? ` within the ${teamDiv} division` : ''} for the ${activeSeason} season in Greater Cincinnati.`
        }
    });

    if (teamClub) {
        faqEntities.push({
            "@type": "Question",
            "name": `Which soccer club is ${rawName} affiliated with?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": `${rawName} is affiliated with ${teamClub}, an established youth soccer organization operating in the Greater Cincinnati area.`
            }
        });
    }

    faqEntities.push({
        "@type": "Question",
        "name": `Where can I find official schedules and standings for ${rawName}?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `Official schedule links, standings, and division info for ${rawName} are aggregated on cincinnati.soccer with direct links to official league portals.`
        }
    });

} else if (typeof type !== 'undefined' && type === 'club') {
    const clubN = title;
    const teamCount = typeof teams !== 'undefined' && teams ? teams.length : 0;
    const descText = typeof clubAbout !== 'undefined' && clubAbout ? clubAbout : '';

    faqEntities.push({
        "@type": "Question",
        "name": `What youth soccer teams belong to ${clubN} in Cincinnati?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${clubN} fields ${teamCount > 0 ? teamCount : 'multiple'} active team roster(s) across CPL and BPYSL leagues in Greater Cincinnati for ${activeSeason}.`
        }
    });

    if (descText) {
        faqEntities.push({
            "@type": "Question",
            "name": `What is the background and philosophy of ${clubN}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": descText
            }
        });
    }

    faqEntities.push({
        "@type": "Question",
        "name": `Where can I view match schedules for ${clubN} teams?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `Complete team directories, division standings, and schedule links for all ${clubN} teams are available on cincinnati.soccer.`
        }
    });

} else if (typeof type !== 'undefined' && type === 'league') {
    const leagueN = title;
    const teamCount = typeof teams !== 'undefined' && teams ? teams.length : 0;
    const descText = typeof leagueAbout !== 'undefined' && leagueAbout ? leagueAbout : '';

    if (descText) {
        faqEntities.push({
            "@type": "Question",
            "name": `What is the ${leagueN}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": descText
            }
        });
    }

    faqEntities.push({
        "@type": "Question",
        "name": `How many teams are registered in ${leagueN} for ${activeSeason}?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${leagueN} currently has ${teamCount} registered teams indexed on cincinnati.soccer for the ${activeSeason} season.`
        }
    });

} else if (typeof type !== 'undefined' && type === 'age') {
    const divN = title;
    const teamCount = typeof teams !== 'undefined' && teams ? teams.length : 0;

    faqEntities.push({
        "@type": "Question",
        "name": `Which youth soccer teams compete in ${divN} in Cincinnati?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${divN} features ${teamCount} active teams competing across local leagues in Southwestern Ohio for ${activeSeason}.`
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": `Where can I track standings and game schedules for ${divN}?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `Full division listings, team links, and schedule portals for ${divN} are compiled on cincinnati.soccer.`
        }
    });

} else if (typeof type !== 'undefined' && type === 'tournament') {
    const tObj = typeof tournament !== 'undefined' ? tournament : {};
    const tName = tObj.name || title;
    const tDates = tObj.dates || 'Upcoming Season';
    const tHost = tObj.hostClub ? `hosted by ${tObj.hostClub}` : 'hosted by local soccer organizers';
    const tVenues = tObj.venues && tObj.venues.length > 0 
        ? tObj.venues.map(v => `${v.name} (${v.city})`).join(', ') 
        : 'Greater Cincinnati venues';

    faqEntities.push({
        "@type": "Question",
        "name": `When and where does ${tName} take place?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${tName} takes place ${tDates} at ${tVenues} in the Greater Cincinnati region.`
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": `Who hosts and organizes ${tName}?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${tName} is ${tHost}, featuring competitive youth bracket play for teams from across Ohio, Kentucky, and Indiana.`
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": `Where can I find official schedules and division brackets for ${tName}?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `Official schedules, bracket flights, and participating team listings for ${tName} are available on cincinnati.soccer with direct links to official tournament portals.`
        }
    });

    if (tObj.ageGroups && tObj.ageGroups.length > 0) {
        faqEntities.push({
            "@type": "Question",
            "name": `What age divisions participate in ${tName}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": `${tName} features competitive divisions across ${tObj.ageGroups.join(', ')} age categories.`
            }
        });
    }

} else if (typeof type !== 'undefined' && type === 'tournaments') {
    faqEntities.push({
        "@type": "Question",
        "name": "What youth soccer tournaments take place in Greater Cincinnati?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Greater Cincinnati hosts premier youth soccer tournaments including the Summer End Showdown, Party on the Pitch, Community Kickoff Classic, and Queen City Fall Classic across premier turf facilities in Hamilton, Butler, and Warren counties."
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": "Where can I find schedules, brackets, and participating teams for Cincinnati tournaments?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "cincinnati.soccer aggregates competitive tournament listings, division flights, and official schedule links for youth soccer teams across Southwestern Ohio."
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": "Which tournament platforms are used by Cincinnati soccer tournaments?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cincinnati tournaments utilize official tournament management platforms including TourneyCentral, GotSport, and Exposure Soccer."
        }
    });

} else if (typeof type !== 'undefined' && type === 'clubs') {
    faqEntities.push({
        "@type": "Question",
        "name": "What youth soccer clubs operate in Greater Cincinnati?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Greater Cincinnati is home to over 60 competitive youth soccer clubs including Cincinnati United (CUP), Kings Hammer SC, Cincinnati West SC, Ohio Galaxies FC, Total Futbol Academy (TFA), Warren County Soccer Academy, Kolping SC, and Cincinnati Elite FC."
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": "How can I find team schedules for a specific Cincinnati soccer club?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Browse the Club Directory on cincinnati.soccer to select any local club and view their complete active team rosters, league divisions, and official schedule links."
        }
    });

} else if (typeof type !== 'undefined' && type === 'ages') {
    faqEntities.push({
        "@type": "Question",
        "name": "How are youth soccer age divisions organized in Cincinnati?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cincinnati youth soccer divisions range from grassroots U7 and U8 developmental leagues up to competitive U19 and High School brackets, categorized by birth year and gender across CPL, BPYSL, and OSSL."
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": "Where can I view standings and team lists for a specific age group?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use the Age Divisions directory on cincinnati.soccer to view all active boys and girls teams competing in any specific age bracket."
        }
    });

} else if (typeof type !== 'undefined' && type === 'leagues') {
    faqEntities.push({
        "@type": "Question",
        "name": "What competitive youth soccer leagues are active in Southwestern Ohio?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Key youth soccer leagues in the Cincinnati area include Cardinal Premier League (CPL), Buckeye Premier Youth Soccer League (BPYSL), Ohio Soccer State League (OSSL), and Club v Club (CvC)."
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": "How do local leagues compare in competitive level?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cardinal Premier League (CPL) serves as the primary regional league for local Cincinnati squads, Buckeye Premier (BPYSL) offers state-level competition across Central and Southern Ohio, and OSSL provides elite statewide league play."
        }
    });

} else {
    // Default / Homepage FAQ
    faqEntities.push({
        "@type": "Question",
        "name": "What youth soccer leagues operate in Greater Cincinnati?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "cincinnati.soccer indexes schedules, standings, and team rosters for Cardinal Premier League (CPL), Buckeye Premier Youth Soccer League (BPYSL), Ohio Soccer State League (OSSL), and Club v Club (CvC)."
        }
    });
    faqEntities.push({
        "@type": "Question",
        "name": "Where can I find schedules and standings for Cincinnati youth soccer teams?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "cincinnati.soccer is the centralized directory for youth soccer schedules, standings, and team rankings across Southwestern Ohio, indexing over 1,380 active teams."
        }
    });
}

schemaBlocks.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqEntities
});

// C. BreadcrumbList Schema
if (currentUrl !== (domain + '/')) {
    let breadcrumbItems = [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": domain + '/'
        }
    ];

    if (typeof type !== 'undefined' && type === 'tournament') {
        const tObj = typeof tournament !== 'undefined' ? tournament : {};
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 2,
            "name": "Tournaments",
            "item": domain + '/tournaments.html'
        });
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 3,
            "name": tObj.name || title,
            "item": currentUrl
        });
    } else if (typeof type !== 'undefined' && type === 'tournaments') {
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 2,
            "name": "Tournaments",
            "item": currentUrl
        });
    } else if (typeof type !== 'undefined' && type === 'team') {
        const rawName = typeof teamName !== 'undefined' ? teamName : title;
        const firstR = typeof teamRows !== 'undefined' && teamRows && teamRows[0] ? teamRows[0] : {};
        const teamClub = firstR.CLUB && firstR.CLUB !== 'Independent' ? firstR.CLUB : null;
        
        if (teamClub) {
            const clubSlug = teamClub.toLowerCase().replace(/[^a-z0-9]/g, '-');
            breadcrumbItems.push({
                "@type": "ListItem",
                "position": 2,
                "name": teamClub,
                "item": `${domain}/club-${clubSlug}.html`
            });
        } else {
            breadcrumbItems.push({
                "@type": "ListItem",
                "position": 2,
                "name": "Clubs",
                "item": `${domain}/clubs.html`
            });
        }
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 3,
            "name": rawName,
            "item": currentUrl
        });
    } else if (typeof type !== 'undefined' && type === 'club') {
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 2,
            "name": "Clubs",
            "item": domain + '/clubs.html'
        });
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 3,
            "name": title,
            "item": currentUrl
        });
    } else if (typeof type !== 'undefined' && type === 'league') {
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 2,
            "name": "Leagues",
            "item": domain + '/leagues.html'
        });
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 3,
            "name": title,
            "item": currentUrl
        });
    } else if (typeof type !== 'undefined' && type === 'age') {
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 2,
            "name": "Age Divisions",
            "item": domain + '/ages.html'
        });
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 3,
            "name": title,
            "item": currentUrl
        });
    } else {
        breadcrumbItems.push({
            "@type": "ListItem",
            "position": 2,
            "name": title,
            "item": currentUrl
        });
    }

    schemaBlocks.push({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbItems
    });
}
%>
<script type="application/ld+json">
<%- JSON.stringify(schemaBlocks, null, 2) %>
</script>

