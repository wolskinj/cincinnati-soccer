<% 
let rawTitle = typeof title !== 'undefined' && title ? title : 'cincinnati.soccer';
let metaTitle = rawTitle;
const BRAND = ' | cincinnati.soccer';
const MAX_TITLE_LEN = 59;

if (!metaTitle.includes('cincinnati.soccer')) {
    const avail = MAX_TITLE_LEN - BRAND.length;
    if (metaTitle.length > avail) {
        let truncated = metaTitle.substring(0, avail - 3);
        const lastSpace = truncated.lastIndexOf(' ');
        if (lastSpace > 12) {
            truncated = truncated.substring(0, lastSpace);
        }
        metaTitle = truncated.trim() + '...';
    }
    metaTitle = metaTitle + BRAND;
}

let metaDesc = typeof description !== 'undefined' ? description : '';
if (typeof clubAbout !== 'undefined' && clubAbout) metaDesc = clubAbout;
if (typeof divisionAbout !== 'undefined' && divisionAbout) metaDesc = divisionAbout;
if (typeof leagueAbout !== 'undefined' && leagueAbout) metaDesc = leagueAbout;
metaDesc = metaDesc.replace(/<[^>]*>?/gm, '').trim();
if (!metaDesc) {
    metaDesc = "The centralized directory for Cincinnati youth soccer schedules, standings, and team rankings. Track CPL, BPYSL, and club teams in one place.";
}

let currentUrl = typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : (domain + '/');
let defaultOgImage = domain + '/assets/social-share-og.jpg';
let shareImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : defaultOgImage;
let shareImageAlt = typeof ogImageAlt !== 'undefined' && ogImageAlt ? ogImageAlt : (metaTitle + " - Cincinnati Youth Soccer");
let modDate = typeof isoDate !== 'undefined' && isoDate ? isoDate : new Date().toISOString();
%>
<!-- 1. Critical Character Encoding & Viewport -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- 2. Primary Title & SEO Metadata -->
<title><%- metaTitle %></title>
<meta name="description" content="<%- metaDesc %>">
<link rel="canonical" href="<%- currentUrl %>">
<meta name="theme-color" content="#002147">

<!-- 3. Early Network Resource Hints & Asynchronous External Scripts -->
<link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin>
<link rel="dns-prefetch" href="https://googleads.g.doubleclick.net">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7915021068737339" crossorigin="anonymous"></script>

<!-- 4. Favicons & Web App Manifest -->
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon.png">
<link rel="shortcut icon" href="/assets/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/assets/site.webmanifest">

<!-- 5. Resource Discovery Feeds & Data Freshness Signals -->
<link rel="alternate" type="application/json" title="Cincinnati Soccer Directory Search Index" href="/search-index.json">
<meta property="article:modified_time" content="<%- modDate %>">
<meta property="og:updated_time" content="<%- modDate %>">

<!-- 6. Open Graph Social Media Meta Tags -->
<meta property="og:site_name" content="cincinnati.soccer">
<meta property="og:locale" content="en_US">
<meta property="og:type" content="website">
<meta property="og:url" content="<%- currentUrl %>">
<meta property="og:title" content="<%- metaTitle %>">
<meta property="og:description" content="<%- metaDesc %>">
<meta property="og:image" content="<%- shareImage %>">
<meta property="og:image:secure_url" content="<%- shareImage %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%- shareImageAlt %>">

<!-- 7. Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%- metaTitle %>">
<meta name="twitter:description" content="<%- metaDesc %>">
<meta name="twitter:image" content="<%- shareImage %>">
<meta name="twitter:image:alt" content="<%- shareImageAlt %>">

<!-- 8. JSON-LD Structured Data (Schema.org) -->
<%
let schemaBlocks = [];

// A. Primary Entity Schema
if (typeof type !== 'undefined' && type === 'team') {
  schemaBlocks.push({
    "@context": "https://schema.org",
    "@type": "SportsTeam",
    "name": typeof teamName !== 'undefined' ? teamName : title,
    "sport": "Soccer",
    "url": currentUrl,
    "description": metaDesc,
    "dateModified": modDate,
    "location": {
      "@type": "Place",
      "name": "Cincinnati, OH"
    }
  });
} else if (typeof type !== 'undefined' && type === 'club') {
  schemaBlocks.push({
    "@context": "https://schema.org",
    "@type": "SportsOrganization",
    "name": title,
    "sport": "Soccer",
    "areaServed": "Cincinnati",
    "url": currentUrl,
    "description": metaDesc,
    "dateModified": modDate
  });
} else {
  schemaBlocks.push({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "url": currentUrl,
    "description": metaDesc,
    "dateModified": modDate
  });
}

// B. Dynamic FAQPage Schema
let faqEntities = [];

if (typeof type !== 'undefined' && type === 'team') {
    const rawName = typeof teamName !== 'undefined' ? teamName : title;
    const firstR = typeof teamRows !== 'undefined' && teamRows && teamRows[0] ? teamRows[0] : {};
    const teamClub = firstR.CLUB && firstR.CLUB !== 'Independent' ? firstR.CLUB : null;
    const teamDiv = firstR.DIVISION || '';
    const teamLeague = firstR.LEAGUE || '';

    faqEntities.push({
        "@type": "Question",
        "name": `What league and division does ${rawName} play in for Fall 2026?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${rawName} competes in the ${teamLeague || 'local youth soccer league'}${teamDiv ? ` within the ${teamDiv} division` : ''} for the Fall 2026 season in Greater Cincinnati.`
        }
    });

    if (teamClub) {
        faqEntities.push({
            "@type": "Question",
            "name": `Which soccer club is ${rawName} affiliated with?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": `${rawName} is affiliated with ${teamClub}, an established youth soccer organization operating in the Greater Cincinnati area.`
            }
        });
    }

    faqEntities.push({
        "@type": "Question",
        "name": `Where can I find official schedules and standings for ${rawName}?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `Official schedule links, standings, and division info for ${rawName} are aggregated on cincinnati.soccer with direct links to official league portals.`
        }
    });

} else if (typeof type !== 'undefined' && type === 'club') {
    const clubN = title;
    const teamCount = typeof teams !== 'undefined' && teams ? teams.length : 0;
    const descText = typeof clubAbout !== 'undefined' && clubAbout ? clubAbout : '';

    faqEntities.push({
        "@type": "Question",
        "name": `What youth soccer teams belong to ${clubN} in Cincinnati?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${clubN} fields ${teamCount > 0 ? teamCount : 'multiple'} active team roster(s) across CPL and BPYSL leagues in Greater Cincinnati for Fall 2026.`
        }
    });

    if (descText) {
        faqEntities.push({
            "@type": "Question",
            "name": `What is the background and philosophy of ${clubN}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": descText
            }
        });
    }

    faqEntities.push({
        "@type": "Question",
        "name": `Where can I view match schedules for ${clubN} teams?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `Complete team directories, division standings, and schedule links for all ${clubN} teams are available on cincinnati.soccer.`
        }
    });

} else if (typeof type !== 'undefined' && type === 'league') {
    const leagueN = title;
    const teamCount = typeof teams !== 'undefined' && teams ? teams.length : 0;
    const descText = typeof leagueAbout !== 'undefined' && leagueAbout ? leagueAbout : '';

    if (descText) {
        faqEntities.push({
            "@type": "Question",
            "name": `What is the ${leagueN}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": descText
            }
        });
    }

    faqEntities.push({
        "@type": "Question",
        "name": `How many teams are registered in ${leagueN} for Fall 2026?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${leagueN} currently has ${teamCount} registered teams indexed on cincinnati.soccer for the Fall 2026 season.`
        }
    });

} else if (typeof type !== 'undefined' && type === 'age') {
    const divN = title;
    const teamCount = typeof teams !== 'undefined' && teams ? teams.length : 0;

    faqEntities.push({
        "@type": "Question",
        "name": `Which youth soccer teams compete in ${divN} in Cincinnati?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `${divN} features ${teamCount} active teams competing across local leagues in Southwestern Ohio for Fall 2026.`
        }
    });

    faqEntities.push({
        "@type": "Question",
        "name": `Where can I track standings and game schedules for ${divN}?`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `Full division listings, team links, and schedule portals for ${divN} are compiled on cincinnati.soccer.`
        }
    });

} else {
    // Default / Homepage FAQ
    faqEntities.push({
        "@type": "Question",
        "name": "What youth soccer leagues operate in Greater Cincinnati?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "cincinnati.soccer indexes schedules, standings, and team rosters for Cardinal Premier League (CPL), Buckeye Premier Youth Soccer League (BPYSL), Ohio Soccer State League (OSSL), and Club v Club (CvC)."
        }
    });
    faqEntities.push({
        "@type": "Question",
        "name": "Where can I find schedules and standings for Cincinnati youth soccer teams?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "cincinnati.soccer is the centralized directory for youth soccer schedules, standings, and team rankings across Southwestern Ohio, indexing over 1,380 active teams."
        }
    });
}

schemaBlocks.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqEntities
});

// C. BreadcrumbList Schema
if (currentUrl !== (domain + '/')) {
    schemaBlocks.push({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": domain + '/'
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": title,
                "item": currentUrl
            }
        ]
    });
}
%>
<script type="application/ld+json">
<%- JSON.stringify(schemaBlocks, null, 2) %>
</script>
